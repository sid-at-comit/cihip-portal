# CIHIP Environment Configuration & Live Email SMTP Settings
# Copy this file to .env and insert your actual credentials:
# cp .env.example .env

# Server Network Settings
PORT=8080
CIHIP_HOST=0.0.0.0

# Security Key
CIHIP_SECRET_KEY=cihip-sec-pki-hmac-sha256-gov-india-2026

# --- Live Gmail SMTP Configuration ---
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a 16-character App Password (e.g. abcd efgh ijkl mnop)
# 3. Paste the 16 characters into SMTP_PASSWORD below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-actual-email@gmail.com
SMTP_PASSWORD=your16charpasswordhere
SMTP_FROM=your-actual-email@gmail.com
SMTP_USE_TLS=true
